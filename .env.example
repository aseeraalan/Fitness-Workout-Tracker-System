# Copy this file to `.env` in the repository root and fill in local values.
# Never commit real credentials.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fitness_tracker

# Set to true to use an in-memory MongoDB for local demos without installing MongoDB.
# Data is discarded when the API process stops. Do not use this in production.
MONGO_MEMORY=false

# Long random string used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-secret

# Exact origins used by the frontend and backend
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:5000

# Google OAuth 2.0 (optional for local username/password auth)
# Create credentials in Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
